# --- Required secrets ---
PAGE_ACCESS_TOKEN=            # Send API token (Page or System User token)
APP_SECRET=                   # Meta app secret (webhook HMAC + data-deletion signed_request)
VERIFY_TOKEN=                 # webhook subscription handshake token (you choose it)
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=               # random string; signs admin cookies + CSRF tokens

# --- Meta ---
FB_PAGE_ID=                   # page asset id: Send target + Conversations API + inbox links
MESSENGER_PAGE_TOKEN=         # PAGE-type token for Conversations/Personas (#190 with system-user tokens)
PERSONA_ID=                   # optional Messenger persona ("SOJAG AI"); blank = plain Page identity
PUBLIC_URL=https://bot.dejureacademy.net

# --- LLM ---
LLM_PROVIDER=gemini           # gemini | openrouter
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=60        # measured 12-29s per turn; 30 was cutting off real replies
LLM_MAX_CONCURRENT=25
LLM_MAX_TOKENS=4096           # a CAP, not a spend; a model that hits it mid-thought returns NO text at all

# --- Sinks ---
GOOGLE_SHEET_WEBAPP_URL=      # Apps Script web app /exec URL (see old repo deploy/apps-script.gs)
SHEET_SHARED_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAYMENT_ALERTS=               # false disables payment-claim alerts
LEAD_DIGEST_TIME=21:00        # Asia/Dhaka; off disables

# --- Behaviour ---
LEAD_MSG_THRESHOLD=3
FOLLOWUP_DELAY_MINUTES=0    # 0 disables; keep under 1440 (Meta 24h messaging window)
REPLY_MIN_SECONDS=5
REPLY_MAX_SECONDS=10
MEMORY_ENABLED=               # false pauses persistence + customer recall

# --- Optional features (all off by default) ---
KNOWLEDGE_RAG_ENABLED=false   # pgvector Knowledge for long-tail content (needs Postgres; embeds via LLM_PROVIDER)
SHADOW_MODE=false             # pre-cutover: run everything, send nothing, record drafts (scripts/shadow_compare.py)
SELFCHECK_DISABLED=false      # true skips the boot-time Telegram ping + Graph token probe (tests only)
AGENTOS_ENABLED=false         # mount Agno's AgentOS control plane at /os (traces, runs, sessions)
OS_SECURITY_KEY=              # REQUIRED when AGENTOS_ENABLED — bearer token for /os

# --- Admin panel (optional restricted editor account) ---
EDITOR_USERNAME=
EDITOR_PASSWORD=

# --- Infra ---
POSTGRES_PASSWORD=            # used by docker-compose for the db service
# Outside compose, point at your own Postgres:
# DATABASE_URL=postgresql+asyncpg://dejure:...@localhost:5433/dejure
PORT=3000
